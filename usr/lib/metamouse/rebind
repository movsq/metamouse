#!/bin/sh
# metamouse-rebind DEV
#   DEV = hid device kernel name, e.g. 0003:1AF3:0001.0006
# Move the device from whatever HID driver currently holds it (hid-generic)
# to metamouse, so our input_mapping remap takes effect. Idempotent.
#
# Safety: never leave the mouse unbound. We only unbind it from its current
# driver once metamouse is actually loaded and ready to take over, and if the
# handoff fails we rebind it to the driver that held it before -- otherwise a
# missing/failed module (e.g. not rebuilt after a kernel upgrade) would strand
# the mouse with no driver at all and it would stop working entirely.
set -e
dev="$1"
[ -n "$dev" ] || exit 1

modprobe metamouse 2>/dev/null || true

# If metamouse isn't loaded/registered, there is nothing to hand off to.
# Leave the device on its current driver rather than killing the mouse.
if [ ! -d /sys/bus/hid/drivers/metamouse ]; then
	exit 0
fi

cur=""
[ -e "/sys/bus/hid/devices/$dev/driver" ] &&
	cur=$(basename "$(readlink -f "/sys/bus/hid/devices/$dev/driver")")

[ "$cur" = "metamouse" ] && exit 0

if [ -n "$cur" ]; then
	echo -n "$dev" > "/sys/bus/hid/drivers/$cur/unbind" 2>/dev/null || true
fi
echo -n "$dev" > /sys/bus/hid/drivers/metamouse/bind 2>/dev/null || true

# Verify the handoff. If metamouse did not take the device, put it back on the
# driver that held it before so the mouse keeps working.
new=""
[ -e "/sys/bus/hid/devices/$dev/driver" ] &&
	new=$(basename "$(readlink -f "/sys/bus/hid/devices/$dev/driver")")

if [ "$new" != "metamouse" ] && [ -n "$cur" ]; then
	echo -n "$dev" > "/sys/bus/hid/drivers/$cur/bind" 2>/dev/null || true
fi
